# Автообновление бота из GitHub; запускается heat-bot-update.timer. Ставится скриптом deploy/install.sh.
[Unit]
Description=Telegram bot «Нет тепла? Сообщите!» — update from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash @BOT_DIR@/deploy/update.sh

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token
# ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111
# Чат/группа, куда пересылать новые заявки (необязательно; по умолчанию — администраторам)
ADMIN_CHAT_ID=
# Путь к базе заявок
DB_PATH=reports.db
# Google Таблица: URL веб-приложения Apps Script (см. README). Пусто — не отправлять
GOOGLE_SCRIPT_URL=
# С какого номера начать заявки в новой базе (при переезде: следующий за последним номером в таблице)
REPORT_START=
# Оператор персональных данных (152-ФЗ): ФИО или название организации, контакты для обращений.
# Попадают в текст согласия и политики обработки персональных данных
OPERATOR_NAME=
OPERATOR_CONTACT=
# Срок хранения заявок в днях; более старые удаляются автоматически
RETENTION_DAYS=365
